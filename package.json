{
  "name": "halcyon-line",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/check-pages-limits.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p server",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:pages": "node tools/check-pages-limits.mjs",
    "selfplay": "tsx tools/selfplay.ts",
    "validate:map": "tsx tools/validate-map.ts",
    "pack:offline": "node tools/pack-offline.mjs",
    "perf": "node tools/perf.mjs",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name halcyon-line",
    "relay:dev": "npx wrangler dev -c server/wrangler.toml",
    "relay:deploy": "npx wrangler deploy -c server/wrangler.toml"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@webgpu/types": "^0.1.74",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@babylonjs/core": "^9.31.2",
    "@babylonjs/havok": "^1.3.14"
  }
}
